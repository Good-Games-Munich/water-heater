{
  "name": "water-heater",
  "version": "0.2.0",
  "description": "A api and discord bot for Good Games Munich",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "rm -rf dist && nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prepare": "husky install"
  },
  "author": "Luis Beu <me@luisbeu.de> (https://luisbeu.de/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Good-Games-Munich/water-heater.git"
  },
  "keywords": [
    "nestjs",
    "discord",
    "bot"
  ],
  "bugs": {
    "url": "https://github.com/Good-Games-Munich/water-heater/issues"
  },
  "homepage": "https://github.com/Good-Games-Munich/water-heater#readme",
  "lint-staged": {
    "*.{js,ts,json,yml,yaml}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "@nanogiants/nestjs-swagger-api-exception-decorator": "1.7.4",
    "@nestjs/common": "11.2.12",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-fastify": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "12.0.3",
    "discord.js": "14.28.1",
    "i18next": "27.2.2",
    "necord": "6.14.0",
    "pg": "8.23.1",
    "ts-error": "1.0.6",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@beuluis/eslint-config": "3.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "11.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "better-sqlite3": "12.11.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "lint-staged": "17.6.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
